# Copy to .env and fill in real values. Never commit .env.

# --- Local (non-Docker) dev ---
# Postgres connection string. Ignored by docker-compose, which builds this
# from POSTGRES_* below instead.
DATABASE_URL=postgres://postgres:postgres@localhost:5432/melik

# --- docker-compose only ---
# Credentials for the postgres container; also used to build the app
# container's DATABASE_URL automatically.
POSTGRES_DB=melik
POSTGRES_USER=melik
POSTGRES_PASSWORD=
# Host port the app is published on (your reverse proxy forwards to this).
APP_PORT=3000

# Random secrets — generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=
STORAGE_SIGNING_SECRET=

# Shared secret the two cron hook routes require in the X-Cron-Secret header.
# Generate the same way as above.
CRON_SECRET=

# Directory where uploaded files (recipe images, avatars, chat images) are
# stored. In Docker this should match the mounted volume path.
UPLOADS_DIR=./data/uploads

# OpenAI API key for the Chef AI (Kiko) assistant.
OPENAI_API_KEY=

# This app's own public domain, used to whitelist links an admin can send in
# broadcast notifications (see admin-notifications.functions.ts). Leave blank
# to only allow melikbakery.com links.
APP_DOMAIN=

# ElevenLabs Agents credentials for the Kiko voice assistant.
ELEVENLABS_API_KEY=
ELEVENLABS_AGENT_ID=
